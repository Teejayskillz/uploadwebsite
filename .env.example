# Copy to .env next to manage.py and fill in. NEVER commit the real .env.

# --- core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
DJANGO_ENV=production
ALLOWED_HOSTS=my.nzdworld.com
CSRF_TRUSTED_ORIGINS=https://my.nzdworld.com
SITE_URL=https://my.nzdworld.com

# --- database (own DB, never the blog's) --------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- storage ------------------------------------------------------------
# Must be OUTSIDE every document root.
VIDEO_ROOT=/home/jaraflix/videos
TEMP_ROOT=/home/jaraflix/videos/tmp
# The account's own byte budget (not df()); drives storage warnings.
STORAGE_BUDGET_BYTES=53687091200

# --- blog integration ---------------------------------------------------
BLOG_API_BASE_URL=https://nzdworld.com
# Shared HMAC secret for blog <-> uploader API calls (32+ random bytes).
API_SHARED_SECRET=

# --- behaviour ----------------------------------------------------------
UPLOADER_MAX_CONCURRENT_JOBS=1
UPLOADER_QUEUE_MAX_ATTEMPTS=3
UPLOADER_WORKER_STALE_SECONDS=600
UPLOADER_TOKEN_TTL_MINUTES=30
UPLOADER_STORAGE_RESERVE_BYTES=2147483648
SECURE_SSL_REDIRECT=True
# Set to True only if the web server does not forward HTTPS to the app.
TRUST_PROXY_HTTPS=False
LOG_LEVEL=INFO

# --- media tooling (FFmpeg 7.0.2-static) --------------------------------
# Absolute paths: Passenger does not inherit an interactive shell's PATH.
FFMPEG_BINARY=/home/jaraflix/bin/ffmpeg
FFPROBE_BINARY=/home/jaraflix/bin/ffprobe
# True in production: fail an import loudly instead of storing un-branded files.
MEDIA_TOOLING_REQUIRED=True
FFPROBE_TIMEOUT_SECONDS=60
FFMPEG_TIMEOUT_SECONDS=600
THUMBNAIL_TIMEOUT_SECONDS=120
THUMBNAIL_WIDTH=640
THUMBNAIL_SUBDIR=thumbs
# Re-encoding is off unless you explicitly want conversion (loses quality).
ALLOW_TRANSCODE=False
TRANSCODE_CRF=20
TRANSCODE_PRESET=veryfast
